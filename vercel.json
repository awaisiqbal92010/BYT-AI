{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "functions": {
    "app/api/generate/route.ts": {
      "maxDuration": 300
    },
    "app/api/sandbox/proxy/[id]/[[...path]]/route.ts": {
      "maxDuration": 60
    },
    "app/api/appetize/build/route.ts": {
      "maxDuration": 120
    },
    "app/api/projects/route.ts": {
      "maxDuration": 30
    }
  }
}
