# -----------------------------------------------------------------------------
# BYT Environment Configuration Template
# DO NOT put real keys/secrets in this file.
# Copy this file to .env.local for local development.
# -----------------------------------------------------------------------------

# Firebase Client Configuration (Safe for browser / public)
NEXT_PUBLIC_FIREBASE_API_KEY="your-firebase-api-key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your-project-id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your-project.firebasestorage.app"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your-messaging-sender-id"
NEXT_PUBLIC_FIREBASE_APP_ID="your-app-id"
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=""

# Firebase Admin SDK (Server-only — NEVER expose to browser)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxx@your-project-id.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvgIBADANBgkqhkiG9w0BAQEFAASCBKgwggSkAgEAAoIBAQC...\n-----END PRIVATE KEY-----\n"

# AI Inference Providers (Server-only)
# [server-only] OpenRouter API key for LLM cascading
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
# [server-only] Optional custom referer for OpenRouter rankings (defaults to https://byt-ai.vercel.app)
OPENROUTER_HTTP_REFERER="https://byt-ai.vercel.app"
# [server-only] Mistral AI API key for fallback reasoning & code generation
MISTRAL_API_KEY="your-mistral-api-key"

# E2B Sandbox MicroVM Provider (Server-only)
# [server-only] E2B API Key used to spawn isolated dev server sandboxes
E2B_API_KEY="e2b_your-api-key"

# Supabase (Public Client Keys - safe for browser, optional if using Firebase)
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-anon-key"
# [server-only] Supabase service role secret
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# Redis Cache / Rate Limiting (Server-only, optional - falls back to in-memory)
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# Appetize.io Mobile Emulator (Server-only)
APPETIZE_API_KEY="tok_your-developer-api-key"
APPETIZE_ADMIN_KEY="tok_your-admin-api-key"
APPETIZE_PUBLIC_KEY="demo"

# Build / CI bypass
SKIP_ENV_VALIDATION=
