# -----------------------------------------------------------------------------
# BYT Environment Configuration Template
# DO NOT put real keys/secrets in this file.
# Copy this file to .env.local for local development.
# -----------------------------------------------------------------------------

# Supabase (Public Client Keys - safe for browser)
# [public] Supabase project URL
NEXT_PUBLIC_SUPABASE_URL="https://your-project.supabase.co"
# [public] Supabase anonymous public key
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key"

# Supabase (Server Admin - NEVER expose to browser)
# [server-only] Service role secret key with full database privileges
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key"

# AI Inference Providers (Server-only)
# [server-only] OpenRouter API key for LLM cascading
OPENROUTER_API_KEY="sk-or-v1-your-openrouter-key"
# [server-only] Optional custom referer for OpenRouter rankings (defaults to https://byt-ai.vercel.app)
OPENROUTER_HTTP_REFERER="https://byt-ai.vercel.app"
# [server-only] Mistral AI API key for fallback reasoning & code generation
MISTRAL_API_KEY="your-mistral-api-key"

# E2B Sandbox MicroVM Provider (Server-only)
# [server-only] E2B API Key used to spawn isolated dev server sandboxes
E2B_API_KEY="e2b_your-api-key"

# Redis Cache / Rate Limiting (Server-only, optional - falls back to in-memory)
# [server-only] Upstash REST URL
UPSTASH_REDIS_REST_URL=""
# [server-only] Upstash REST Token
UPSTASH_REDIS_REST_TOKEN=""

# Appetize.io Mobile Emulator (Server-only)
# [server-only] Developer API key for uploading apps and managing sessions
APPETIZE_API_KEY="tok_your-developer-api-key"
# [server-only] Admin API key — higher privilege (rotate, delete apps)
APPETIZE_ADMIN_KEY="tok_your-admin-api-key"

# Build / CI bypass
# [server-only] Set to 1 to bypass strict Zod env validation during non-secret CI builds
SKIP_ENV_VALIDATION=
